# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The mock Supabase env (scripts/mock-supabase) holds no secrets and is committed.
!.env.mock

# vercel
.vercel

# cloudflare / wrangler
.wrangler
.open-next
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP screenshots
.playwright-mcp/
.design/refs/

# Claude Code local state (tracked exceptions below)
.claude/*
!.claude/archive/
!.claude/PUNCHLIST.md
!.claude/HANDOFF-design-audit.md

# Scratch lists
squares-list.*
