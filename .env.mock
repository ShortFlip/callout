# Local fake Supabase (scripts/mock-supabase). Committed on purpose: these are
# not secrets. `npm run dev:mock` puts them in the process environment before
# `next dev` starts, and Next never overrides a variable that is already set,
# so they win over anything in .env.local (the LIVE project).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54399
# JWT-shaped dummy anon key ({"alg":"HS256","typ":"JWT"}.{"iss":"mock-supabase","role":"anon"}.sig).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJtb2NrLXN1cGFiYXNlIiwicm9sZSI6ImFub24ifQ.bW9jay1zaWduYXR1cmUtbm90LWEtcmVhbC1rZXk
